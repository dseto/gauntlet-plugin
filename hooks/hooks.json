{
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Bash|PowerShell",
        "hooks": [{ "type": "command", "command": "node \"${CLAUDE_PLUGIN_ROOT}/hooks/bash-guard.mjs\"", "timeout": 10 }]
      },
      {
        "matcher": "Edit|Write|MultiEdit|NotebookEdit",
        "hooks": [{ "type": "command", "command": "node \"${CLAUDE_PLUGIN_ROOT}/hooks/file-guard.mjs\"", "timeout": 10 }]
      },
      {
        "matcher": "Agent|Task",
        "hooks": [{ "type": "command", "command": "node \"${CLAUDE_PLUGIN_ROOT}/hooks/orchestrator-breaker.mjs\"", "timeout": 10 }]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "Edit|Write|MultiEdit",
        "hooks": [{ "type": "command", "command": "node \"${CLAUDE_PLUGIN_ROOT}/hooks/fast-file-check.mjs\"", "timeout": 15 }]
      }
    ],
    "SubagentStop": [
      {
        "matcher": "builder|gauntlet:builder",
        "hooks": [{ "type": "command", "command": "node \"${CLAUDE_PLUGIN_ROOT}/hooks/builder-stop-gate.mjs\"", "timeout": 1800 }]
      }
    ]
  }
}
