{
  "schema_version": 1,
  "secret_files": [
    ".env"
  ],
  "hook_payload": {
    "pretooluse_agent_type": true
  },
  "commands": {
    "fast_lint": {
      "cmd": [
        "py",
        "-3",
        "-m",
        "py_compile"
      ],
      "exts": [
        ".py"
      ]
    },
    "build": "NONE",
    "test": [
      {
        "name": "pytest",
        "cwd": ".",
        "cmd": [
          ".venv/Scripts/python.exe",
          "-m",
          "pytest",
          "-q"
        ],
        "seconds": 60,
        "junit": "pytest"
      }
    ]
  },
  "protected_files": [
    "pytest.ini"
  ]
}
